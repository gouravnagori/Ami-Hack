# Application
APP_ENV=development # Environment: development, staging, production, test
DEBUG=true # Verbose logging and debug flags
PORT=8000 # Server port
HOST=0.0.0.0 # Server host bind address
PROJECT_NAME="GoldenHour API" # Application title in OpenAPI docs

# Security & Auth
SECRET_KEY="goldenhour-insecure-dev-secret-key-change-in-production-min32chars" # JWT signing secret key
ALGORITHM="HS256" # JWT signing algorithm
ACCESS_TOKEN_EXPIRE_MINUTES=15 # JWT access token expiry in minutes (Section 6 & Appendix A3)
REFRESH_TOKEN_EXPIRE_DAYS=7 # JWT refresh token expiry in days (Section 6 & Appendix A3)
DEMO_MODE=true # Enable /auth/demo instant role logins and bypasses for tests/demo
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"] # Allowed CORS origins

# Databases
DATABASE_URL="postgresql+asyncpg://goldenhour:goldenhour@localhost:5432/goldenhour" # PostgreSQL + PostGIS connection string
DATABASE_ECHO=false # Log raw SQL queries when true
REDIS_URL="redis://localhost:6379/0" # Redis 7 connection URL for locks, pubsub, matrix cache

# Spatial & Seeding Defaults
SEED_CENTER_LAT=28.6139 # Default city center latitude (New Delhi)
SEED_CENTER_LNG=77.2090 # Default city center longitude (New Delhi)
SEED_RADIUS_KM=15.0 # Geofence radius in km for seed generator and dispatch bounds

# Routing & External Providers
OSRM_URL="http://localhost:5000" # OSRM routing server URL (fallback haversine used if unreachable)
MATRIX_CACHE_TTL_SECONDS=300 # Redis cache duration for OSRM distance matrices

# Operational Dispatch & Safety Defaults
DISPATCH_TICK_SECONDS=10 # Interval between driver dispatch loop executions
RISK_MONITOR_SECONDS=15 # Interval for tracking active deliveries and recalculating risk
STALE_DRIVER_SECONDS=90 # Inactivity timeout before flagging a driver as stale
STALE_DRIVER_REASSIGN_SECONDS=180 # Inactivity timeout before reassigning driver stops
CO2E_PER_KG=2.5 # Estimated kg CO2e saved per kg food rescued (placeholder: cite source before pilot)
PORTION_KG=0.4 # Default kg weight per portion

# Optional AI Features (Feature Flagged)
AGENT_ENABLED=false # Enable autonomous dispatch AI communication agent
LLM_PARSE_MODEL="gemini-1.5-flash" # Model ID for donation free-text / photo parsing
LLM_AGENT_MODEL="gemini-1.5-pro" # Model ID for dispatch communication agent
LLM_API_KEY="" # Provider API key for LLM services (if empty, deterministic fallback is used)
