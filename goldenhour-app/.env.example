# ============================================================
# GoldenHour Environment Configuration
# ============================================================

# Toggle Mock Data Layer (true = in-memory Jaipur MSW simulation, false = live backend)
VITE_USE_MOCKS=true

# Real Backend Endpoints (Used when your friend's backend is running)
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws

# MapLibre Tile Server (Defaults to open Demotiles / OpenStreetMap)
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
