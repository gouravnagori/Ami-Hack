  "faq": {
    "eyebrow": "FAQ",
    "items": [
      {
        "q": "How does GoldenHour keep food safe?",
        "a": "Every donation gets a safe-until time. We only match food that can arrive before it, and we never route food past it."
      },
      {
        "q": "What if a shelter can't take it?",
        "a": "Offers move to the next best shelter automatically. If none can, it goes to a compost or animal-feed partner."
      },
      {
        "q": "Do I need to install an app?",
        "a": "No. It's a web app you can add to your home screen."
      },
      {
        "q": "What if a driver is running late?",
        "a": "We re-plan the route, hand the stop to a closer driver, or alert everyone involved."
      }
    ]
  },
